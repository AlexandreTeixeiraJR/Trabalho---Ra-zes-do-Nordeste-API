digraph Arquitetura {
 graph [rankdir=TB,bgcolor=white,pad="0.5",ranksep="0.6",fontname="Arial",label="Arquitetura em camadas - monólito modular",labelloc=t,fontsize=24];
 node [shape=box,style="rounded,filled",fillcolor="#f0f5f7",fontname="Arial",fontsize=15,margin="0.3"];
 canais [label="App / Web / Totem / Balcão / Pickup\nConsumidores da mesma API"];
 api [label="API - app/main.py\nRotas, JWT, perfis, erros, OpenAPI"];
 application [label="Application - app/application.py\nPedidos, pagamentos, estoque e transações"];
 domain [label="Domain - app/domain.py\nContratos, enums, validações e transições"];
 infra [label="Infrastructure - app/infrastructure.py\nSQLite, migrações, scrypt, auditoria e GatewayMock"];
 db [label="SQLite persistente\nForeign keys + CHECK + UNIQUE + WAL"];
 mock [label="Pagamento simulado\nAPROVADO / RECUSADO / TIMEOUT"];
 canais -> api [label="HTTP / JSON"];
 api -> application; api -> domain [label="validação"];
 application -> domain [label="regras"];
 application -> infra;
 infra -> db; infra -> mock;
}
